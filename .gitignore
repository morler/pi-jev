node_modules/
dist/
.DS_Store
.env
.env.*
!.env.example
*.log
npm-debug.log*

# Pi local state: extension caches, session files, and judge outputs.
# .pi/settings.json is shared Pi config and stays tracked; use `git add -f` for other shared config.
# The negation only works because the parent is not excluded wholesale.
.pi/*
!.pi/settings.json
